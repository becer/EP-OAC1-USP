    </comp>
    <comp lib="6" loc="(560,48)" name="Text">
      <a name="text" val="CLK = clock (mesmo dos outros contadores) | EN = habilita a contagem (ligar no CO da dezena de minuto)"/>
    </comp>
    <comp lib="6" loc="(560,71)" name="Text">
      <a name="text" val="Todos os D passam pelo mux D = EN*f + EN'*Q. Estados invalidos voltam para 00."/>
    </comp>
